# ==========================================
# Application
# ==========================================

APP_NAME=CS AI Assistant
DEBUG=true

# ==========================================
# Frontend
# ==========================================

FRONTEND_URL=http://localhost:3000

# ==========================================
# PostgreSQL
# ==========================================

DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/cs_ai_assistant

# ==========================================
# Groq STT
# ==========================================

GROQ_API_KEY=your_groq_api_key
GROQ_STT_MODEL=whisper-large-v3
STT_TIMEOUT_SECONDS=6

# ==========================================
# Gemini
# ==========================================

GEMINI_API_KEY=your_gemini_api_key

# สามารถเปลี่ยน model ภายหลังได้โดยไม่แก้ source code
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_TIMEOUT_SECONDS=10

# ==========================================
# Edge TTS
# ==========================================

TTS_VOICE=th-TH-NiwatNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_PITCH=+0Hz

# ==========================================
# Face Recognition
# ==========================================

FACE_MODEL=buffalo_m
FACE_DETECTION_SIZE=640
FACE_THRESHOLD=0.45
IP_CAMERA_URL=http://192.168.0.11:8080

# ==========================================
# Admin
# ==========================================

ADMIN_TOKEN=change_this_to_a_long_random_secret
